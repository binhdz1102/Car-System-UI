<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/notification_card_background">
    <TextView
        android:id="@+id/notification_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/notification_panel_accent"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/notification_panel_text"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/notification_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textColor="@color/notification_panel_secondary"
        android:textSize="15sp" />
</LinearLayout>
