<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_control_panel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/systembar_panel_height"
    android:background="@drawable/systembar_panel_background"
    android:orientation="vertical"
    android:padding="@dimen/systembar_panel_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_control_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/systembar_text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/quick_control_close"
            style="@style/SystemBarQuickButton"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>
    <TextView
        android:id="@+id/quick_control_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/systembar_secondary_text"
        android:textSize="18sp" />
    <Switch
        android:id="@+id/quick_control_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Enabled"
        android:textOn=""
        android:textOff=""
        android:textColor="@color/systembar_text"
        android:textSize="18sp" />
    <SeekBar
        android:id="@+id/quick_control_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone" />
    <Button
        android:id="@+id/quick_control_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Open settings" />
</LinearLayout>
