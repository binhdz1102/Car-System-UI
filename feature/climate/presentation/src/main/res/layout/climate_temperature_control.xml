<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        android:id="@+id/climate_zone_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/climate_panel_secondary"
        android:textSize="16sp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/climate_decrease"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Decrease temperature"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/climate_panel_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/climate_temperature"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/climate_panel_text"
            android:textSize="30sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/climate_increase"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Increase temperature"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/climate_panel_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
