<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/climate_panel_root"
    android:layout_width="@dimen/climate_panel_width"
    android:layout_height="@dimen/climate_panel_height"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/climate_panel_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Climate"
            android:textColor="@color/climate_panel_text"
            android:textSize="26sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/climate_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Close climate panel"
            android:src="@drawable/climate_close"
            android:tint="@color/climate_panel_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">
        <include
            android:id="@+id/driver_temperature_control"
            layout="@layout/climate_temperature_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <include
            android:id="@+id/passenger_temperature_control"
            layout="@layout/climate_temperature_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Switch
            android:id="@+id/climate_ac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A/C"
            android:textOn=""
            android:textOff=""
            android:textColor="@color/climate_panel_text" />
        <Switch
            android:id="@+id/climate_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="AUTO"
            android:textOn=""
            android:textOff=""
            android:textColor="@color/climate_panel_text" />
        <TextView
            android:id="@+id/climate_fan_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/climate_panel_secondary"
            android:textSize="15sp" />
    </LinearLayout>
    <SeekBar
        android:id="@+id/climate_fan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progressTint="@color/climate_panel_accent"
        android:thumbTint="@color/climate_panel_text" />
</LinearLayout>
